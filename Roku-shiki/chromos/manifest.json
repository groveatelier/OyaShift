{
  "name": "六式 親指シフトキー入力",
  "version": "1.4.6",
  "manifest_version": 3,
  "description": "親指シフトキー入力を実現します。",
  "action": {
    "default_popup": "dictdlg.html",
    "default_icon": {
      "16": "rokuicon-b.png",
      "48": "rokuicon-s.png",
      "128": "rokuicon-l.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "GranShiftBG.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "input",
    "scripting",
    "offscreen", 
	  "storage",
    "downloads"
  ],
  "icons": {
    "16": "rokuicon-b.png",
    "48": "rokuicon-s.png",
    "128": "rokuicon-l.png"
  },
  "input_components": [
    {
      "name": "親指シフト (日本語) キー入力",
      "type": "ime",
      "id": "GranShift",
      "description": "親指シフト キー入力", 
      "language": "GS", 
      "layouts": ["us"] 
    }
  ]
}
